# Symphony Launch Configuration

# Browser Automation
HEADLESS=false  # Set to true for headless mode (after first successful run)
AUTO_BUY=true   # Automatically execute initial buy
INITIAL_BUY_SOL=5  # Amount of SOL to buy initially

# Twitter API (optional - for auto-posting)
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# Gemini API (optional - for logo generation)
GEMINI_API_KEY=

# Monitoring
CHECK_INTERVAL_MS=60000  # How often to check price/holders (milliseconds)
